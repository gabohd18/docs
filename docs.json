{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "El Nido",
  "description": "Punto de venta con tarjeta digital de puntos para cafeterías, restaurantes, panaderías y tiendas en México. Sin comisiones, sin contratos.",
  "colors": {
    "primary": "#6B6B6B",
    "light": "#9A9A9A",
    "dark": "#4A4A4A"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "languages": [
      {
        "language": "es",
        "default": true,
        "groups": [
          {
            "group": "Empezar",
            "icon": "play",
            "pages": [
              "es/index",
              "es/que-es-un-pos"
            ]
          }
        ]
      },
      {
        "language": "en",
        "groups": [
          {
            "group": "Get started",
            "icon": "play",
            "pages": [
              "en/index",
              "en/what-is-a-pos"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Ir a la app",
        "href": "https://elnidopos.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Prueba 60 días gratis",
      "href": "https://elnidopos.com"
    }
  },
  "footer": {
    "socials": {}
  }
}
